# Server
PORT=5000
NODE_ENV=development

# Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_in_production

# Database (SQLite). Override to relocate the db file (e.g. persistent disk on Render).
DB_PATH=

# Seed (run only when no admin user exists)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Set both to destroy the schema and re-seed: FORCE_SYNC=true CONFIRM_FORCE_SYNC=yes
FORCE_SYNC=false
CONFIRM_FORCE_SYNC=no